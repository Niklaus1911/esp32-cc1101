menu "CC1101 radio configuration"

    comment "GPIO0/1/2/3/5/6-12/15-17 are rejected at runtime"

    config CC1101_SPI_SCLK_GPIO
        int "CC1101 SCK GPIO"
        range 0 33
        default 18

    config CC1101_SPI_MISO_GPIO
        int "CC1101 MISO/GDO1 GPIO"
        range 0 39
        default 19

    config CC1101_SPI_MOSI_GPIO
        int "CC1101 MOSI GPIO"
        range 0 33
        default 23

    config CC1101_SPI_CS_GPIO
        int "CC1101 CSN GPIO"
        range 0 33
        default 27

    config CC1101_GDO0_GPIO
        int "CC1101 GDO0 asynchronous TX GPIO"
        range 0 33
        default 26

    config CC1101_GDO2_GPIO
        int "CC1101 GDO2 asynchronous RX GPIO"
        range 0 39
        default 25

    config CC1101_XTAL_HZ
        int "CC1101 crystal frequency (Hz)"
        range 26000000 27000000
        default 26000000
        help
            Generic CC1101 V2.0 modules normally use a 26 MHz crystal.

    config CC1101_FREQUENCY_HZ
        int "RF center frequency (Hz)"
        range 387000000 464000000
        default 433920000

    config CC1101_TX_POWER_DBM
        int "Nominal CC1101 transmit power (dBm)"
        range -30 10
        default 5
        help
            Nominal reference-design value. Actual module power and legal limits vary.

    config CC1101_RX_INVERT
        bool "Invert GDO2 receive input in the ESP32 GPIO matrix"
        default n

endmenu
